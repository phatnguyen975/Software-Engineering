{
  "name": "e2e",
  "version": "1.0.0",
  "description": "E2E tests for EShop SUT",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web-chromium --project=web-firefox --project=web-webkit",
    "test:admin": "playwright test --project=admin-chromium --project=admin-firefox --project=admin-webkit",
    "test:chromium": "playwright test --project=web-chromium --project=admin-chromium",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "test:fr01": "playwright test tests/web/fr-01-registration.spec.ts --project=web-chromium --project=web-firefox --project=web-webkit",
    "test:fr03": "playwright test tests/web/fr-03-forgot-password.spec.ts --project=web-chromium --project=web-firefox --project=web-webkit",
    "test:fr17": "playwright test tests/admin/fr-17-coupon-management.spec.ts --project=admin-chromium --project=admin-firefox --project=admin-webkit",
    "test:fr01:chromium": "playwright test tests/web/fr-01-registration.spec.ts --project=web-chromium",
    "test:fr03:chromium": "playwright test tests/web/fr-03-forgot-password.spec.ts --project=web-chromium",
    "test:fr17:chromium": "playwright test tests/admin/fr-17-coupon-management.spec.ts --project=admin-chromium",
    "test:fr01:debug": "playwright test tests/web/fr-01-registration.spec.ts --project=web-chromium --headed --workers=1 --retries=0",
    "test:fr03:debug": "playwright test tests/web/fr-03-forgot-password.spec.ts --project=web-chromium --headed --workers=1 --retries=0",
    "test:fr17:debug": "playwright test tests/admin/fr-17-coupon-management.spec.ts --project=admin-chromium --headed --workers=1 --retries=0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2"
  }
}
