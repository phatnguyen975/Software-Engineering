{
  "info": {
    "name": "FR01 — POST /api/register",
    "schema": "https://schema.postman.com/collection/json/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.add({",
          "    key: 'X-Student-Id',",
          "    value: pm.environment.get('studentId') || '23127449'",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "[Control] Iteration Router",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://postman-echo.com/get",
          "protocol": "https",
          "host": ["postman-echo", "com"],
          "path": ["get"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.iteration > 0) {",
              "    postman.setNextRequest('Data-Driven Template');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Static TCs",
      "item": [
        {
          "name": "TC-SEC",
          "item": [
            {
              "name": "TC-FR01-SEC-001 — Verify response body does not expose password field",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"SecTest\",\n  \"email\": \"sectest2@domain.com\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SEC-001 — Verify response body does not expose password field — Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"TC-FR01-SEC-001 — Verify response body does not expose password field — Response does not have password\", function () {",
                      "    pm.expect(pm.response.json()).to.not.have.property(\"password\");",
                      "    const body = pm.response.json();",
                      "    pm.expect(body).to.have.property(\"message\");",
                      "    pm.expect(body).to.have.property(\"id\");",
                      "    pm.expect(body.id).to.be.a(\"number\");",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "TC-FR01-SEC-002 — Verify SQL injection in email field does not cause data leak",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Sec Test\",\n  \"email\": \"' OR '1'='1\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SEC-002 — Verify SQL injection in email field does not cause data leak — Status code is 400\", function () {",
                      "    pm.response.to.have.status(400);",
                      "});",
                      "pm.test(\"TC-FR01-SEC-002 — Verify SQL injection in email field does not cause data leak — Response has error field\", function () {",
                      "    pm.expect(pm.response.json()).to.have.property(\"error\");",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "TC-FR01-SEC-003 — Verify SQL injection in name field is blocked",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"'; SELECT * FROM users;--\",\n  \"email\": \"sqli2@domain.com\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SEC-003 — Verify SQL injection in name field is blocked — Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"TC-FR01-SEC-003 — Verify SQL injection in name field is blocked — Response has message and id\", function () {",
                      "    pm.expect(pm.response.json()).to.have.property(\"message\");",
                      "    pm.expect(pm.response.json()).to.have.property(\"id\");",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "TC-FR01-SEC-004 — Verify error response does not expose raw SQL messages",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@eshop.com\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SEC-004 — Verify error response does not expose raw SQL messages — Status code is 500\", function () {",
                      "    pm.response.to.have.status(500);",
                      "});",
                      "pm.test(\"TC-FR01-SEC-004 — Verify error response does not expose raw SQL messages — Response has error field\", function () {",
                      "    pm.expect(pm.response.json()).to.have.property(\"error\");",
                      "});",
                      "pm.test(\"TC-FR01-SEC-004 — Verify error response does not expose raw SQL messages — No SQL text in body\", function () {",
                      "    const body = pm.response.text();",
                      "    pm.expect(body).to.not.include(\"SQLITE_CONSTRAINT\");",
                      "    pm.expect(body).to.not.include(\"syntax error\");",
                      "});"
                    ]
                  }
                }
              ]
            },
