{
  "info": {
    "_postman_id": "REPLACE_WITH_UUID",
    "name": "{feature_id} — {METHOD} {PATH}",
    "description": "Generated test collection for {METHOD} {PATH}.\nFeature: {feature_id}.\nGenerated by: api-collection skill.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{baseUrl}}",
      "type": "string",
      "description": "Base URL — set in environment file"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ── Collection-level Pre-request Script ──────────────────────────",
          "",
          "// 1. Custom header injection",
          "const injectHeaderName = pm.environment.get('injectHeaderName');",
          "const injectHeaderValue = pm.environment.get('injectHeaderValue');",
          "if (injectHeaderName && injectHeaderValue) {",
          "  pm.request.headers.add({ key: injectHeaderName, value: injectHeaderValue });",
          "}",
          "",
          "// 2. Auth token management (remove block if endpoint requires no auth)",
          "// Adjust token variable name and login credentials per endpoint auth type.",
          "const token = pm.environment.get('userToken');",
          "if (!token) {",
          "  pm.sendRequest(",
          "    {",
          "      url: pm.environment.get('baseUrl') + '/api/login',",
          "      method: 'POST',",
          "      header: { 'Content-Type': 'application/json' },",
          "      body: {",
          "        mode: 'raw',",
          "        raw: JSON.stringify({",
          "          email: pm.environment.get('userEmail'),",
          "          password: pm.environment.get('userPassword')",
          "        })",
          "      }",
          "    },",
          "    function (err, res) {",
          "      if (!err && res.code === 200) {",
          "        pm.environment.set('userToken', res.json().token);",
          "      }",
          "    }",
          "  );",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test script — leave empty unless all requests share a common assertion"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "[Control] Iteration Router",
      "request": {
        "method": "GET",
        "url": {
          "raw": "https://postman-echo.com/get",
          "protocol": "https",
          "host": ["postman-echo", "com"],
          "path": ["get"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// This router skips the static folder in subsequent iterations",
              "if (pm.info.iteration > 0) {",
              "    postman.setNextRequest('Data-Driven Template');",
              "}"
            ]
          }
        }
      ]
    },
